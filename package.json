{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"format:php": "php vendor/bin/pint",
		"format:blade": "prettier --write \"resources/views/**/*.blade.php\"",
		"format:blade:check": "prettier --check \"resources/views/**/*.blade.php\"",
		"format:js": "eslint resources/js --fix",
		"format:all": "npm run format:php && npm run format:blade && npm run format:js",
		"format": "npm run format:all",
		"lint:js": "eslint resources/js",
		"lint:blade": "prettier --check \"resources/views/**/*.blade.php\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@shufo/prettier-plugin-blade": "^1.5.7",
		"@tailwindcss/vite": "^4.2.4",
		"autoprefixer": "^10.5.0",
		"axios": "^1.16.0",
		"blade-formatter": "^1.28.0",
		"concurrently": "^10.0.3",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.5",
		"laravel-vite-plugin": "^3.1.0",
		"postcss": "^8.5.3",
		"prettier": "^3.5.3",
		"prettier-plugin-blade": "^2.1.21",
		"tailwindcss": "^4.2.4",
		"vite": "^8.0.16"
	}
}
